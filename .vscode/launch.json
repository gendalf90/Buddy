{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: Buddy Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Buddy/bin/Debug/net10.0/Buddy.dll",
            "cwd": "${workspaceFolder}/src/Buddy/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5001"
            }
        }
    ]
}
